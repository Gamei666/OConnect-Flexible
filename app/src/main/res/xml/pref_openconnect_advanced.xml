<?xml version="1.0" encoding="utf-8"?>
<!-- Modified for OConnect Flexible. Fork snapshot 2026-11-20. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:layout="@layout/preference_category_header" android:title="@string/dynamic_split_title">
        <Preference android:title="@string/server_split_title" android:summary="@string/server_split_summary"
            android:layout="@layout/preference_standard_compact" android:selectable="false" />
        <SwitchPreference android:key="dynamic_split_enabled" android:title="@string/dynamic_split_enable"
            android:layout="@layout/preference_standard_compact" android:summary="@string/dynamic_split_summary" android:defaultValue="false" />
        <EditTextPreference android:key="dynamic_split_include" android:title="@string/dynamic_split_include"
            android:layout="@layout/preference_standard_compact" android:dependency="dynamic_split_enabled"
            android:dialogMessage="@string/dynamic_split_include_help" android:inputType="textMultiLine|textNoSuggestions" android:defaultValue="" />
        <EditTextPreference android:key="dynamic_split_exclude" android:title="@string/dynamic_split_exclude"
            android:layout="@layout/preference_standard_compact" android:dependency="dynamic_split_enabled"
            android:dialogMessage="@string/dynamic_split_exclude_help" android:inputType="textMultiLine|textNoSuggestions" android:defaultValue="" />
        <Preference android:title="@string/dynamic_split_limit_title" android:summary="@string/dynamic_split_limit_summary"
            android:layout="@layout/preference_standard_compact" android:selectable="false" />
    </PreferenceCategory>
    <PreferenceCategory
        android:layout="@layout/preference_category_header"
        android:title="@string/client_identity">
        <ListPreference
            android:key="reported_os"
            android:title="@string/reported_os"
            android:layout="@layout/preference_standard_compact"
            android:dialogTitle="@string/reported_os"
            android:entries="@array/reported_os_entries"
            android:entryValues="@array/reported_os_values"
            android:defaultValue="android" />
        <app.openconnect.ShowTextPreference
            android:key="custom_csd_wrapper"
            android:title="@string/custom_csd_wrapper"
            android:layout="@layout/preference_standard_compact"
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_header"
        android:title="@string/network_and_protocol">
        <ListPreference
            android:key="split_tunnel_mode"
            android:title="@string/split_tunnel_mode"
            android:layout="@layout/preference_standard_compact"
            android:dialogTitle="@string/split_tunnel_mode"
            android:entries="@array/split_tunnel_mode_entries"
            android:entryValues="@array/split_tunnel_mode_values"
            android:defaultValue="auto" />
        <EditTextPreference
            android:key="split_tunnel_networks"
            android:title="@string/split_tunnel_networks"
            android:layout="@layout/preference_standard_compact"
            android:dialogMessage="@string/split_tunnel_networks_message"
            android:inputType="textUri|textMultiLine|textNoSuggestions"
            android:defaultValue="" />
        <SwitchPreference
            android:key="disable_xml_post"
            android:title="@string/disable_xml_post"
            android:layout="@layout/preference_standard_compact"
            android:summary="@string/disable_xml_post_summary"
            android:defaultValue="false" />
        <SwitchPreference
            android:key="require_pfs"
            android:title="@string/require_pfs"
            android:layout="@layout/preference_standard_compact"
            android:summary="@string/require_pfs_summary"
            android:defaultValue="false" />
        <SwitchPreference
            android:key="dpd_override"
            android:title="@string/dpd_override"
            android:layout="@layout/preference_standard_compact"
            android:summary="@string/dpd_override_summary"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="dpd_value"
            android:title="@string/dpd_value"
            android:layout="@layout/preference_standard_compact"
            android:dependency="dpd_override"
            android:dialogMessage="@string/dpd_value_message"
            android:inputType="number"
            android:defaultValue="" />
    </PreferenceCategory>
</PreferenceScreen>
